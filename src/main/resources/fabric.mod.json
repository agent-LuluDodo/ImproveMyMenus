{
  "schemaVersion": 1,
  "id": "improvemymenus",
  "version": "${version}",
  "name": "ImproveMyMenus",
  "description": "A collection of small improvements to various aspects of Minecraft's menus.",
  "authors": [
    "agent_LuluDodo"
  ],
  "contact": {
    "sources": "https://github.com/agent-LuluDodo/ImproveMyMenus",
    "issues": "https://github.com/agent-LuluDodo/ImproveMyMenus/issues"
  },
  "license": "MIT",
  "icon": "assets/improvemymenus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.luludodo.improvemymenus.ImproveMyMenus"
    ],
    "modmenu": [
      "de.luludodo.improvemymenus.compatibility.ImproveMyMenusModMenuIntegration"
    ]
  },
  "mixins": [
    "improvemymenus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "accessWidener": "improvemymenus.classtweaker"
}
